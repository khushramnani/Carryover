# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret. Server only — used by the Discord interactions endpoint, which has no
# user session to borrow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Used in the "you haven't signed in yet" nudge the bot replies with.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "1" adds a "Try as test user" button on the sign-in page: the full app with no
# Discord, data kept in the visitor's localStorage (never the database).
# Build-time (NEXT_PUBLIC_), so redeploy after changing it.
NEXT_PUBLIC_DEMO_MODE=

# ── Discord ───────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Secret. Server only — a bot token is a full-guild credential.
DISCORD_BOT_TOKEN=

# The Figmenta server. Membership of this guild IS the access gate: no guild,
# no sign-in. Required — sign-in is refused outright when it is unset.
DISCORD_GUILD_ID=

# Private-beta allowlist of Discord user ids, comma-separated. Gates both web
# sign-in and slash commands. Leave empty/unset in production to open it up.
BETA_DISCORD_USER_IDS=
